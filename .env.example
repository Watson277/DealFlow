# Copy this file to .env before development and replace every change_me value.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
MAX_RFP_UPLOAD_SIZE_BYTES=52428800
PDF_PARSER_VERSION=native-1.0
PDF_MAX_PAGES=500
PDF_TEXT_MIN_EFFECTIVE_CHARS=20
PDF_TEXT_MAX_GARBLED_RATIO=0.10
PDF_SCANNED_IMAGE_COVERAGE_THRESHOLD=0.60
PDF_MIXED_IMAGE_COVERAGE_THRESHOLD=0.35

# MySQL 8 (host access)
DEALFLOW_MYSQL_DATABASE=dealflow
DEALFLOW_MYSQL_USER=dealflow
DEALFLOW_MYSQL_PASSWORD=dealflow_mysql_change_me
DEALFLOW_MYSQL_ROOT_PASSWORD=dealflow_root_change_me
DEALFLOW_MYSQL_PORT=3307
DATABASE_URL=mysql+aiomysql://dealflow:dealflow_mysql_change_me@localhost:3307/dealflow
# Use this URL from containers attached to the dealflow network.
DATABASE_URL_DOCKER=mysql+aiomysql://dealflow:dealflow_mysql_change_me@mysql:3306/dealflow

# Redis 7
DEALFLOW_REDIS_PASSWORD=dealflow_redis_change_me
DEALFLOW_REDIS_PORT=6380
REDIS_URL=redis://:dealflow_redis_change_me@localhost:6380/0
REDIS_URL_DOCKER=redis://:dealflow_redis_change_me@redis:6379/0

# Kafka (KRaft mode, no ZooKeeper)
DEALFLOW_KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:29092
KAFKA_CLIENT_ID=dealflow-api
KAFKA_RFP_TOPIC=rfp.uploaded
KAFKA_RFP_COMPLETED_TOPIC=rfp.completed
KAFKA_RFP_FAILED_TOPIC=rfp.failed
KAFKA_REQUIREMENTS_EXTRACTED_TOPIC=rfp.requirements.extracted
KAFKA_CAPABILITIES_EVALUATED_TOPIC=rfp.capabilities.evaluated
KAFKA_PROPOSAL_GENERATED_TOPIC=proposal.generated
KAFKA_PROPOSAL_APPROVED_TOPIC=proposal.approved
KAFKA_RFP_WORKER_GROUP=dealflow-rfp-workers
KAFKA_REQUIREMENT_WORKER_GROUP=dealflow-requirement-workers
KAFKA_CAPABILITY_WORKER_GROUP=dealflow-capability-workers
KAFKA_PROPOSAL_WORKER_GROUP=dealflow-proposal-workers
RFP_LOCK_TTL_SECONDS=300
RFP_LOCK_ACQUIRE_TIMEOUT_SECONDS=10
DEALFLOW_KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Qdrant
DEALFLOW_QDRANT_HTTP_PORT=6333
DEALFLOW_QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_URL_DOCKER=http://qdrant:6333
QDRANT_COLLECTION=dealflow_knowledge_glm
QDRANT_SEARCH_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.25

# MinIO
DEALFLOW_MINIO_PORT=9000
DEALFLOW_MINIO_CONSOLE_PORT=9001
DEALFLOW_MINIO_ROOT_USER=dealflow_admin
DEALFLOW_MINIO_ROOT_PASSWORD=dealflow_minio_change_me
MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT_DOCKER=minio:9000
MINIO_SECURE=false
DEALFLOW_MINIO_BUCKET=dealflow

# Zhipu GLM through its OpenAI-compatible Chat Completions API. Never commit real keys.
# ZAI_API_KEY is also accepted as an alias for LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_REASONING_EFFORT=max
LLM_MAX_RETRIES=2
REQUIREMENT_CHUNK_SIZE_CHARS=60000
REQUIREMENT_MAX_CHUNKS=20
REQUIREMENT_MAX_OUTPUT_TOKENS=12000
REQUIREMENT_LOCK_TTL_SECONDS=1800

# Embeddings
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_CHUNK_SIZE_CHARS=1500
KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
CAPABILITY_MAX_OUTPUT_TOKENS=2000
CAPABILITY_LOCK_TTL_SECONDS=1800
CAPABILITY_PROMPT_VERSION=capability-v1
PROPOSAL_MAX_OUTPUT_TOKENS=12000
PROPOSAL_EVIDENCE_MAX_CHARS=1200
PROPOSAL_LOCK_TTL_SECONDS=1800
PROPOSAL_PROMPT_VERSION=proposal-v1
